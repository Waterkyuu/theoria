{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							["react", "react/**"],
							":PACKAGE:",
							"@/components/**",
							"@/hooks/**",
							"@/utils/**",
							[":ALIAS:", "!:STYLE:"],
							[":PATH:", "!:STYLE:"],
							":STYLE:"
						],
						"sortBareImports": true
					}
				}
			}
		},
		"enabled": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"overrides": [
		{
			"assist": {
				"actions": {
					"source": {
						"useSortedKeys": "on"
					}
				}
			},
			"includes": ["**/*.json", "**/*.jsonc"]
		}
	],
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
