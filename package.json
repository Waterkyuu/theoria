{
	"name": "theoria",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.10.0",
	"scripts": {
		"build": "pnpm typecheck && vite build",
		"check": "pnpm lint && pnpm format",
		"check:fix": "oxlint --fix . && pnpm format:fix",
		"dev": "vite",
		"format": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"lint": "oxlint .",
		"lint:staged": "lint-staged --concurrent false",
		"prepare": "husky",
		"preview": "vite preview",
		"rust:check": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets --all-features",
		"rust:format": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
		"rust:format:fix": "cargo fmt --manifest-path src-tauri/Cargo.toml --all",
		"rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
		"rust:test": "cargo test --manifest-path src-tauri/Cargo.toml --all-features",
		"tauri": "node scripts/tauri.mjs",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
	},
	"dependencies": {
		"@codemirror/language": "^6.12.4",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/state": "^6.7.4",
		"@gravity-ui/icons": "^2.22.0",
		"@heroui/react": "^3.2.5",
		"@heroui/styles": "^3.2.5",
		"@tanstack/react-query": "^5.102.8",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2.7.3",
		"@tauri-apps/plugin-opener": "^2",
		"cnfast": "^0.2.0",
		"codemirror": "^6.0.2",
		"i18next": "^26.4.2",
		"katex": "^0.18.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-i18next": "^17.0.13",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^4.12.4",
		"react-router": "8.3.1",
		"rehype-katex": "^7.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"zod": "^4.6.2"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^26.5.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/coverage-v8": "^5.0.0",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"lint-staged": "^17.5.1",
		"material-icon-theme": "^5.38.1",
		"oxc-transform-react": "0.149.0",
		"oxfmt": "0.67.0",
		"oxlint": "1.82.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~7.0.2",
		"vite": "^8.3.0",
		"vitest": "^5.0.0"
	}
}
