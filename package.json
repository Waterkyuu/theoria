{
	"name": "theoria",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.10.0",
	"scripts": {
		"build": "pnpm typecheck && vite build",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"dev": "vite",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"lint": "biome lint .",
		"lint:staged": "lint-staged",
		"prepare": "husky",
		"preview": "vite preview",
		"tauri": "tauri",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
	},
	"dependencies": {
		"@gravity-ui/icons": "^2.22.0",
		"@heroui/react": "^3.2.4",
		"@heroui/styles": "^3.2.4",
		"@tanstack/react-query": "^5.102.6",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"cnfast": "^0.1.0",
		"i18next": "^26.4.0",
		"jotai": "2.20.3",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-i18next": "^17.0.12",
		"react-router": "8.3.0",
		"zod": "^4.5.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.6",
		"@types/node": "^26.3.0",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.0",
		"@vitest/coverage-v8": "^4.1.11",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"lint-staged": "^17.3.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
