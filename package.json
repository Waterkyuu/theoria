{
	"name": "theoria",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.10.0",
	"scripts": {
		"build": "pnpm typecheck && vite build",
		"check": "pnpm lint && pnpm format",
		"check:fix": "oxlint --fix . && pnpm format:fix",
		"dev": "vite",
		"format": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"lint": "oxlint .",
		"lint:staged": "lint-staged --concurrent false",
		"prepare": "husky",
		"preview": "vite preview",
		"tauri": "tauri",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
	},
	"dependencies": {
		"@codemirror/language": "^6.12.4",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/state": "^6.7.4",
		"@gravity-ui/icons": "^2.21.0",
		"@heroui/react": "^3.2.3",
		"@heroui/styles": "^3.2.3",
		"@tanstack/react-query": "^5.101.4",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@tauri-apps/plugin-opener": "^2",
		"cnfast": "^0.1.0",
		"codemirror": "^6.0.2",
		"i18next": "^26.3.6",
		"jotai": "2.20.3",
		"katex": "^0.16.47",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-i18next": "^17.0.11",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^4.12.3",
		"react-router": "8.3.0",
		"rehype-katex": "^7.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"zod": "^4.5.2"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/node": "^26.1.2",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/coverage-v8": "^4.1.10",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"lint-staged": "^17.3.0",
		"material-icon-theme": "^5.38.1",
		"oxc-transform-react": "0.145.0",
		"oxfmt": "0.67.0",
		"oxlint": "1.82.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.10"
	}
}
